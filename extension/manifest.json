{
  "manifest_version": 2,
  "name": "Basic Auth Remember",
  "version": "1.4.1",
  "description": "Signs in to HTTP Basic auth sites for you with logins saved per host pattern, encrypted under your passphrase.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "basic-auth-remember@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "incognito": "spanning",
  "background": {
    "scripts": ["store.js", "vault.js", "background.js"]
  },
  "browser_action": {
    "default_title": "Basic Auth Remember",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
