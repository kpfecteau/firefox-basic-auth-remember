{
  "manifest_version": 2,
  "name": "Basic Auth Remember",
  "version": "1.3.0",
  "description": "Remembers HTTP Basic auth credentials per host pattern and supplies them automatically.",
  "browser_specific_settings": {
    "gecko": {
      "id": "basic-auth-remember@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "incognito": "spanning",
  "background": {
    "scripts": ["store.js", "vault.js", "background.js"]
  },
  "browser_action": {
    "default_title": "Basic Auth Remember",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
