# addons.mozilla.org API credentials for `npm run sign:listed` / `sign:unlisted`.
# Copy this file to .env.amo (git-ignored) and fill in the values from
# https://addons.mozilla.org/developers/addon/api/key/
#   JWT issuer -> WEB_EXT_API_KEY
#   JWT secret -> WEB_EXT_API_SECRET
WEB_EXT_API_KEY=user:00000000:000
WEB_EXT_API_SECRET=paste-your-jwt-secret-here
